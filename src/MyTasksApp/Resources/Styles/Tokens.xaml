<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ================================================================= -->
    <!-- SPACING TOKENS (DESIGN.MD 2.2 - 4pt/8pt GRID)                     -->
    <!-- ================================================================= -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingBase">16</x:Double>
    <x:Double x:Key="SpacingLg">20</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>
    <x:Double x:Key="SpacingXxl">32</x:Double>

    <!-- Standard Padding Thickness -->
    <Thickness x:Key="ScreenPadding">20,16,20,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="BadgePadding">8,4,8,4</Thickness>
    <Thickness x:Key="ButtonPadding">16,12,16,12</Thickness>

    <!-- ================================================================= -->
    <!-- CORNER RADIUS TOKENS (DESIGN.MD 2.4)                              -->
    <!-- ================================================================= -->
    <x:Double x:Key="RadiusSmValue">6</x:Double>
    <x:Double x:Key="RadiusMdValue">12</x:Double>
    <x:Double x:Key="RadiusLgValue">16</x:Double>
    <x:Double x:Key="RadiusFullValue">999</x:Double>

    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">12</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ================================================================= -->
    <!-- TYPOGRAPHY SIZE TOKENS (DESIGN.MD 2.3 - DEFAULT MEDIUM SCALING)   -->
    <!-- ================================================================= -->
    <x:Double x:Key="FontSizeDisplay">26</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">15</x:Double>
    <x:Double x:Key="FontSizeCaption">13</x:Double>
    <x:Double x:Key="FontSizeBadge">12</x:Double>

</ResourceDictionary>
