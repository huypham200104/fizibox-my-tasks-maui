<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyTasksApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MyTasksApp.Views"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    Title="MyTasks"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent x:Name="TabTodayContent"
                      Title="Hôm nay"
                      Route="TodayPage">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="Home" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent x:Name="TabWeekContent"
                      Title="Tuần này"
                      Route="WeekPage">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="Calendar" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent x:Name="TabHistoryContent"
                      Title="Lịch sử"
                      Route="HistoryPage">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="History" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent x:Name="TabSettingsContent"
                      Title="Cài đặt"
                      Route="SettingsPage">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="Settings" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
