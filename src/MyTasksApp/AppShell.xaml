<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyTasksApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MyTasksApp.Views"
    xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
    Title="Việc của tôi"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Hôm nay"
                      Route="TodayPage"
                      ContentTemplate="{DataTemplate views:TodayPage}">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="Home" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent Title="Tuần này"
                      Route="WeekPage"
                      ContentTemplate="{DataTemplate views:WeekPage}">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="Calendar" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent Title="Lịch sử"
                      Route="HistoryPage"
                      ContentTemplate="{DataTemplate views:HistoryPage}">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="History" />
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent Title="Cài đặt"
                      Route="SettingsPage"
                      ContentTemplate="{DataTemplate views:SettingsPage}">
            <ShellContent.Icon>
                <fluent:SymbolImageSource Symbol="Settings" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
