<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyTasksApp.Views.WeekPage"
             Title="Tuần này"
             BackgroundColor="{DynamicResource Background}">

    <VerticalStackLayout Spacing="16" Padding="20">
        <Label Text="Tuần này" 
               FontFamily="InterBold"
               FontSize="{DynamicResource FontSizeDisplay}" 
               TextColor="{DynamicResource TextPrimary}" />
        <Label Text="Theo dõi kế hoạch và tiến độ của bạn" 
               FontFamily="InterRegular"
               FontSize="{DynamicResource FontSizeBody}" 
               TextColor="{DynamicResource TextSecondary}" />
    </VerticalStackLayout>
</ContentPage>
