<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
             xmlns:controls="clr-namespace:MyTasksApp.Controls"
             xmlns:models="clr-namespace:MyTasksApp.Core.Models"
             xmlns:vm="clr-namespace:MyTasksApp.ViewModels"
             x:Class="MyTasksApp.Views.WeekPage"
             x:DataType="vm:WeekViewModel"
             Title="Tuần này"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Background}">

    <Grid>
        <!-- ============================================================= -->
        <!-- MAIN SCROLLABLE CONTENT (WITH PULL-TO-REFRESH)                -->
        <!-- ============================================================= -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{DynamicResource Primary}">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="20" Padding="20,16,20,110">

                    <!-- 1. TOP BRAND BAR (Logo bo góc tròn + Tên app - Đã xóa chip ngày tháng theo yêu cầu) -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border WidthRequest="38"
                                HeightRequest="38"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource Surface}"
                                Padding="3"
                                VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,1"
                                        Radius="3"
                                        Opacity="0.08" />
                            </Border.Shadow>
                            <Image Source="logo.png"
                                   Aspect="AspectFill"
                                   WidthRequest="32"
                                   HeightRequest="32"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <Image.Clip>
                                    <RoundRectangleGeometry Rect="0,0,32,32" CornerRadius="8" />
                                </Image.Clip>
                            </Image>
                        </Border>

                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="MyTasks"
                                   FontFamily="InterBold"
                                   FontSize="18"
                                   TextColor="{DynamicResource Primary}" />
                            <Label Text="{Binding AppSubtitle}"
                                   FontFamily="InterRegular"
                                   FontSize="10"
                                   TextColor="{DynamicResource TextMuted}"
                                   Margin="0,-2,0,0" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- 3. WEEK NAVIGATOR (< dải ngày >) -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <!-- Nút Tuần trước -->
                        <Border WidthRequest="40"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource Surface}"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
                            </Border.GestureRecognizers>
                            <fluent:SymbolIcon Symbol="ChevronLeft"
                                               FontSize="18"
                                               ForegroundColor="{DynamicResource TextPrimary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                        </Border>

                        <!-- Dải ngày tuần đang xem -->
                        <HorizontalStackLayout Grid.Column="1"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Spacing="8">
                            <fluent:SymbolIcon Symbol="Calendar"
                                               FontSize="18"
                                               ForegroundColor="{DynamicResource Primary}"
                                               VerticalOptions="Center" />
                            <Label Text="{Binding WeekRangeText}"
                                   FontFamily="InterSemiBold"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Nút Tuần sau -->
                        <Border Grid.Column="2"
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource Surface}"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextWeekCommand}" />
                            </Border.GestureRecognizers>
                            <fluent:SymbolIcon Symbol="ChevronRight"
                                               FontSize="18"
                                               ForegroundColor="{DynamicResource TextPrimary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- 4. WEEK STRIP (7 NGÀY T2 -> CN - PHÂN BỔ 7 CỘT CHUẨN XÁC KHÔNG BỊ XẾP CHỒNG) -->
