                                BindingContext="{Binding WeekDays[0]}"
                                x:DataType="models:WeekDayItem"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,10"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                                <MultiTrigger TargetType="Border">
                                    <MultiTrigger.Conditions>
                                        <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                        <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </MultiTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayOfWeekShort}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                        </MultiTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding DayNumber}"
                                       FontFamily="InterBold"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center">
