                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                        </MultiTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding TaskCountText}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeBadge}"
                                       TextColor="{DynamicResource TextMuted}"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                        </MultiTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- CỘT 6: CHỦ NHẬT (CN) -->
                        <Border Grid.Column="6"
                                BindingContext="{Binding WeekDays[6]}"
                                x:DataType="models:WeekDayItem"
                                StrokeShape="RoundRectangle 12"
                                Padding="2,10"
                                BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=SelectDayCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="1" />
                                </DataTrigger>
                                <MultiTrigger TargetType="Border">
                                    <MultiTrigger.Conditions>
                                        <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                        <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </MultiTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding DayOfWeekShort}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                        </MultiTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding DayNumber}"
                                       FontFamily="InterBold"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                        </MultiTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding TaskCountText}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeBadge}"
                                       TextColor="{DynamicResource TextMuted}"
                                       HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Label">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding IsSelected}" Value="False" />
                                                <BindingCondition Binding="{Binding IsToday}" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                        </MultiTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- 5. SKELETON SHIMMER LOADING (MÔ PHỎNG TASK CARD 2 TẦNG CHUẨN DESIGN.MD) -->
                    <VerticalStackLayout x:Name="SkeletonContainer" IsVisible="{Binding IsBusy}" Spacing="12">
                        <!-- Thẻ Skeleton mẫu 1 -->
                        <Border BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                <!-- Placeholder Checkbox tròn -->
                                <Border WidthRequest="24"
                                        HeightRequest="24"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{DynamicResource SurfaceVariant}"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        Margin="6,4,6,0" />

                                <!-- Nội dung task skeleton 2 tầng (AGENTS.md Quy chuẩn 6) -->
                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            HeightRequest="14"
                                            WidthRequest="180"
                                            HorizontalOptions="Start" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="14"
                                                WidthRequest="80" />
                                        <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="14"
                                                WidthRequest="60" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Thẻ Skeleton mẫu 2 -->
                        <Border BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                <Border WidthRequest="24"
                                        HeightRequest="24"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{DynamicResource SurfaceVariant}"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        Margin="6,4,6,0" />

                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            HeightRequest="14"
                                            WidthRequest="220"
                                            HorizontalOptions="Start" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="14"
                                                WidthRequest="100" />
                                        <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="14"
                                                WidthRequest="50" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Thẻ Skeleton mẫu 3 -->
                        <Border BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource BorderColor}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                                <Border WidthRequest="24"
                                        HeightRequest="24"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{DynamicResource SurfaceVariant}"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        Margin="6,4,6,0" />

                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            HeightRequest="14"
                                            WidthRequest="150"
                                            HorizontalOptions="Start" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="14"
                                                WidthRequest="70" />
                                        <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                HeightRequest="14"
                                                WidthRequest="65" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- 6. EMPTY STATE (ĐỒNG BỘ QUA CONTROL DÙNG CHUNG) -->
                    <controls:EmptyStateView IsVisible="{Binding IsEmpty}"
                                             Symbol="CalendarEmpty"
                                             Title="{Binding EmptyMessage}"
                                             Subtitle="{Binding EmptySubMessage}" />

                    <!-- 7. DANH SÁCH CÔNG VIỆC CỦA NGÀY (HIỂN THỊ TRỰC TIẾP DƯỚI DẢI 7 NGÀY) -->
                    <VerticalStackLayout IsVisible="{Binding IsNotBusy}" Spacing="12">
                        <BindableLayout.ItemsSource>
                            <Binding Path="DayTasks" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskItem">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=SwipeCompleteText}"
                                                       BackgroundColor="{DynamicResource Success}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=ToggleTaskStatusCommand}"
                                                       CommandParameter="{Binding .}" />
                                            <SwipeItem Text="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=SwipeDeleteText}"
                                                       BackgroundColor="{DynamicResource Danger}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=DeleteTaskCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border BackgroundColor="{DynamicResource Surface}"
                                            Stroke="{DynamicResource BorderColor}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="14,12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=OpenTaskDetailCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <!-- Layout 2 tầng chuẩn Responsive chống tràn chữ (AGENTS.md Quy chuẩn 6) -->
                                        <Grid ColumnDefinitions="Auto, *, Auto"
                                              RowDefinitions="Auto, Auto"
                                              ColumnSpacing="12"
                                              RowSpacing="8">

                                            <!-- Checkbox tròn touch target 36x36dp -->
                                            <Grid Grid.Row="0" Grid.Column="0"
                                                  WidthRequest="36"
                                                  HeightRequest="36"
                                                  VerticalOptions="Center"
                                                  HorizontalOptions="Center">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeekViewModel}}, Path=ToggleTaskStatusCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>

                                                <!-- Chưa hoàn thành -->
                                                <Border WidthRequest="24"
                                                        HeightRequest="24"
                                                        StrokeShape="RoundRectangle 12"
                                                        Stroke="{DynamicResource BorderColor}"
                                                        StrokeThickness="2"
                                                        BackgroundColor="Transparent"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>

                                                <!-- Đã hoàn thành (Tích xanh) -->
                                                <Border WidthRequest="24"
                                                        HeightRequest="24"
                                                        StrokeShape="RoundRectangle 12"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{DynamicResource Success}"
                                                        IsVisible="False"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <fluent:SymbolIcon Symbol="Checkmark"
                                                                       ForegroundColor="White"
                                                                       FontSize="14"
                                                                       HorizontalOptions="Center"
                                                                       VerticalOptions="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Tiêu đề công việc -->
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontFamily="InterSemiBold"
                                                   FontSize="{DynamicResource FontSizeBody}"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   LineBreakMode="WordWrap"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="TextColor" Value="{DynamicResource TextMuted}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Mũi tên điều hướng > -->
                                            <fluent:SymbolIcon Grid.Row="0" Grid.Column="2"
                                                               Symbol="ChevronRight"
                                                               ForegroundColor="{DynamicResource TextMuted}"
                                                               FontSize="18"
                                                               VerticalOptions="Center"
                                                               HorizontalOptions="End" />

                                            <!-- Dòng 2: Tag dự án và Badge giờ -->
                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                   Spacing="8"
                                                                   VerticalOptions="Center">
                                                <!-- Chip Dự án -->
                                                <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="0"
                                                        Padding="8,4">
                                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                        <fluent:SymbolIcon Symbol="Folder"
                                                                           ForegroundColor="{DynamicResource Primary}"
                                                                           FontSize="12"
                                                                           VerticalOptions="Center" />
                                                        <Label Text="{Binding ProjectName}"
                                                               FontFamily="InterMedium"
                                                               FontSize="{DynamicResource FontSizeBadge}"
                                                               TextColor="{DynamicResource TextSecondary}"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>

                                                <!-- Badge Giờ hẹn -->
                                                <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="0"
                                                        Padding="8,4">
                                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                        <fluent:SymbolIcon Symbol="Clock"
                                                                           ForegroundColor="{DynamicResource Warning}"
                                                                           FontSize="12"
                                                                           VerticalOptions="Center" />
                                                        <Label Text="{Binding DueTime, StringFormat='{0:hh\\:mm}'}"
                                                               FontFamily="InterMedium"
                                                               FontSize="{DynamicResource FontSizeBadge}"
                                                               TextColor="{DynamicResource TextSecondary}"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ============================================================= -->
        <!-- FLOATING ACTION BUTTON (FAB +)                                -->
        <!-- ============================================================= -->
        <Border WidthRequest="56"
                HeightRequest="56"
                StrokeShape="RoundRectangle 28"
                StrokeThickness="0"
                BackgroundColor="{DynamicResource Primary}"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,24">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.25" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCreateModalCommand}" />
            </Border.GestureRecognizers>
            <fluent:SymbolIcon Symbol="Add"
                               ForegroundColor="White"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Border>

        <!-- ============================================================= -->
        <!-- MODAL BOTTOM SHEET: TẠO VIỆC NHANH (MẪU POPUP_EDIT_TEXT.PNG)  -->
        <!-- ============================================================= -->
        <Grid x:Name="CreateModalBackdrop"
              IsVisible="{Binding IsCreateModalVisible}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCreateModalCommand}" />
            </Grid.GestureRecognizers>

            <Border x:Name="CreateModalSheet"
                    VerticalOptions="End"
                    MaximumHeightRequest="560"
                    BackgroundColor="{DynamicResource Surface}"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    StrokeThickness="0"
                    Padding="20,16,20,24">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer /> <!-- Chặn sự kiện đóng modal khi chạm vào nội dung card -->
                </Border.GestureRecognizers>

                <ScrollView x:Name="CreateModalScrollView" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="16">
                        <!-- Thanh gạt vuốt ngang phía trên (Drag Handle) -->
                        <BoxView WidthRequest="40"
                                 HeightRequest="4"
                                 CornerRadius="2"
                                 Color="{DynamicResource BorderColor}"
                                 HorizontalOptions="Center"
                                 Margin="0,0,0,4" />

                        <!-- Header Modal -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ModalCreateTitle}"
                                       FontFamily="InterBold"
                                       FontSize="{DynamicResource FontSizeTitle}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding ModalCreateSubtitle}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="{DynamicResource SurfaceVariant}"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseCreateModalCommand}" />
                                </Border.GestureRecognizers>
                                <fluent:SymbolIcon Symbol="Dismiss"
                                                   FontSize="16"
                                                   ForegroundColor="{DynamicResource TextSecondary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Trường 1: Tên công việc -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding FieldTaskTitle}"
                                   FontFamily="InterSemiBold"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Border BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource Primary}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,4">
                                <Entry x:Name="NewTaskTitleEntry"
                                       Text="{Binding NewTaskTitle}"
                                       Placeholder="{Binding FieldTaskTitlePlaceholder}"
                                       PlaceholderColor="{DynamicResource TextMuted}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontFamily="InterRegular"
                                       ReturnType="Next"
                                       Completed="OnTitleEntryCompleted"
                                       Focused="OnFieldFocused" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Trường 2: Dự án -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding FieldTaskProject}"
                                   FontFamily="InterSemiBold"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Border BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,4">
                                <Entry x:Name="NewTaskProjectEntry"
                                       Text="{Binding NewTaskProject}"
                                       Placeholder="{Binding FieldTaskProjectPlaceholder}"
                                       PlaceholderColor="{DynamicResource TextMuted}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontFamily="InterRegular"
                                       ReturnType="Next"
                                       Completed="OnProjectEntryCompleted"
                                       Focused="OnFieldFocused" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Trường 3: Ngày đến hạn & Giờ đến hạn -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding DueDateLabel}"
                                       FontFamily="InterSemiBold"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Border BackgroundColor="{DynamicResource Surface}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,4">
                                    <DatePicker Date="{Binding NewTaskDueDate}"
                                                Format="dd/MM/yyyy"
                                                TextColor="{DynamicResource TextPrimary}"
                                                FontSize="{DynamicResource FontSizeBody}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{Binding DueTimeLabel}"
                                       FontFamily="InterSemiBold"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Border BackgroundColor="{DynamicResource Surface}"
                                        Stroke="{DynamicResource BorderColor}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,4">
                                    <TimePicker Time="{Binding NewTaskDueTime}"
                                                Format="HH:mm"
                                                TextColor="{DynamicResource TextPrimary}"
                                                FontSize="{DynamicResource FontSizeBody}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Trường 4: Mô tả chi tiết -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding FieldTaskDesc}"
                                   FontFamily="InterSemiBold"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Border BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,8">
                                <Editor x:Name="NewTaskDescEditor"
                                        Text="{Binding NewTaskDescription}"
                                        Placeholder="{Binding FieldTaskDescPlaceholder}"
                                        PlaceholderColor="{DynamicResource TextMuted}"
                                        TextColor="{DynamicResource TextPrimary}"
                                        AutoSize="TextChanges"
                                        MaximumHeightRequest="90"
                                        FontSize="{DynamicResource FontSizeBody}"
                                        FontFamily="InterRegular"
                                        Completed="OnDescEditorCompleted"
                                        TextChanged="OnDescEditorTextChanged"
                                        Focused="OnFieldFocused" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nút thao tác Hủy / Lưu -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                            <Button Text="{Binding BtnCancel}"
                                    Command="{Binding CloseCreateModalCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource Primary}"
                                    BorderColor="{DynamicResource Primary}"
                                    BorderWidth="1"
                                    CornerRadius="10"
                                    FontFamily="InterSemiBold"
                                    HeightRequest="46" />
                            <Button Grid.Column="1"
                                    Text="{Binding BtnSaveTask}"
                                    Command="{Binding SaveNewTaskCommand}"
                                    BackgroundColor="{DynamicResource Primary}"
                                    TextColor="White"
                                    CornerRadius="10"
                                    FontFamily="InterSemiBold"
                                    HeightRequest="46" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- FLOATING SNACKBAR (THÔNG BÁO HOÀN THÀNH / XÓA HOÀN TÁC)       -->
        <!-- ============================================================= -->
        <controls:FloatingSnackbarView />

    </Grid>

</ContentPage>
