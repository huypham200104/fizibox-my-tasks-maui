<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
             xmlns:vm="clr-namespace:MyTasksApp.ViewModels"
             x:Class="MyTasksApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Cài đặt"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Background}">

    <Grid>
        <!-- ============================================================= -->
        <!-- NỘI DUNG CHÍNH CUỘN MÀN HÌNH                                  -->
        <!-- ============================================================= -->
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="22" Padding="20,16,20,80">

                <!-- ============================================================= -->
                <!-- 1. HEADER: CÀI ĐẶT & PHỤ ĐỀ (DESIGN.MD 5.4 & 04.setting_screen.png)-->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="4" Margin="0,4,0,4">
                    <Label Text="{Binding SettingsTitle}"
                           FontFamily="InterBold"
                           FontSize="{DynamicResource FontSizeDisplay}"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="{Binding SettingsSubtitle}"
                           FontFamily="InterRegular"
                           FontSize="{DynamicResource FontSizeBody}"
                           TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- 2. SECTION: GIAO DIỆN (APPEARANCE)                            -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="10">
                    <!-- Tiêu đề Section -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <fluent:SymbolIcon Symbol="PaintBrush"
                                           FontSize="18"
                                           ForegroundColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                        <Label Text="{Binding SectionAppearance}"
                               FontFamily="InterSemiBold"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Card tùy chỉnh Giao diện -->
                    <Border BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">

                            <!-- Nhóm: Chế độ giao diện -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ThemeMode}"
                                       FontFamily="InterSemiBold"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding ThemeModeDesc}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Bộ chọn 2 Card Sáng / Tối dạng Mini Window (DESIGN.MD 5.4) -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <!-- Card Theme: Sáng (Light Mode) -->
                                <Border StrokeShape="RoundRectangle 12"
                                        HeightRequest="56"
                                        Padding="8,6"
                                        Stroke="{Binding ThemeLightCardBorder}"
                                        StrokeThickness="{Binding ThemeLightCardBorderThickness}"
                                        BackgroundColor="{Binding ThemeLightCardBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectThemeCommand}" CommandParameter="Light" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <!-- Hình minh họa Mini Window Sáng -->
                                        <Border WidthRequest="38"
                                                HeightRequest="28"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="#CBD5E1"
                                                StrokeThickness="1"
                                                BackgroundColor="White"
                                                Padding="0"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="2">
                                                <!-- Thanh tiêu đề màu xanh Indigo thương hiệu -->
                                                <BoxView HeightRequest="6" Color="{DynamicResource Primary}" />
                                                <!-- Hai vạch tượng trưng nội dung -->
                                                <BoxView HeightRequest="2" WidthRequest="22" Color="#CBD5E1" HorizontalOptions="Center" Margin="0,2,0,0" />
                                                <BoxView HeightRequest="2" WidthRequest="16" Color="#CBD5E1" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Nhãn "Sáng" (LineBreakMode="NoWrap" chống ngắt dòng) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding LightTheme}"
                                               FontFamily="InterMedium"
                                               FontSize="14"
                                               TextColor="{Binding ThemeLightTextColor}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Start"
                                               LineBreakMode="NoWrap" />

                                        <!-- Icon tích xanh khi được chọn -->
                                        <Border Grid.Column="2"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Primary}"
                                                StrokeThickness="0"
                                                IsVisible="{Binding IsLightMode}"
                                                VerticalOptions="Center">
                                            <fluent:SymbolIcon Symbol="Checkmark"
                                                               FontSize="11"
                                                               ForegroundColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Theme: Tối (Dark Mode) -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        HeightRequest="56"
                                        Padding="8,6"
                                        Stroke="{Binding ThemeDarkCardBorder}"
                                        StrokeThickness="{Binding ThemeDarkCardBorderThickness}"
                                        BackgroundColor="{Binding ThemeDarkCardBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectThemeCommand}" CommandParameter="Dark" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <!-- Hình minh họa Mini Window Tối -->
                                        <Border WidthRequest="38"
                                                HeightRequest="28"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="#475569"
                                                StrokeThickness="1"
                                                BackgroundColor="#0F172A"
                                                Padding="0"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="2">
                                                <!-- Thanh tiêu đề xám đen đậm -->
                                                <BoxView HeightRequest="6" Color="#1E293B" />
                                                <!-- Hai vạch tượng trưng nội dung tối -->
                                                <BoxView HeightRequest="2" WidthRequest="22" Color="#334155" HorizontalOptions="Center" Margin="0,2,0,0" />
                                                <BoxView HeightRequest="2" WidthRequest="16" Color="#334155" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <!-- Nhãn "Tối" (LineBreakMode="NoWrap" chống ngắt dòng) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding DarkTheme}"
                                               FontFamily="InterMedium"
                                               FontSize="14"
                                               TextColor="{Binding ThemeDarkTextColor}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Start"
                                               LineBreakMode="NoWrap" />

                                        <!-- Icon tích xanh khi được chọn -->
                                        <Border Grid.Column="2"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Primary}"
                                                StrokeThickness="0"
                                                IsVisible="{Binding IsDarkMode}"
                                                VerticalOptions="Center">
                                            <fluent:SymbolIcon Symbol="Checkmark"
                                                               FontSize="11"
                                                               ForegroundColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Đường kẻ ngăn cách mảnh -->
                            <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="0,4,0,4" />

                            <!-- Nhóm: Cỡ chữ -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding FontSize}"
                                       FontFamily="InterSemiBold"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding FontSizeDesc}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Bộ điều khiển Segmented: Nhỏ / Thường / Lớn (Touch Target 44dp chuẩn AGENTS.md) -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                                <!-- Nút: Nhỏ -->
                                <Border StrokeShape="RoundRectangle 10"
                                        HeightRequest="44"
                                        Stroke="{Binding FontSizeSmallBorder}"
                                        StrokeThickness="{Binding FontSizeSmallBorderThickness}"
                                        BackgroundColor="{Binding FontSizeSmallBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectFontSizeCommand}" CommandParameter="Small" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding FontSizeSmall}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontFamily="InterMedium"
                                           FontSize="14"
                                           TextColor="{Binding FontSizeSmallTextColor}" />
                                </Border>

                                <!-- Nút: Thường -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 10"
                                        HeightRequest="44"
                                        Stroke="{Binding FontSizeNormalBorder}"
                                        StrokeThickness="{Binding FontSizeNormalBorderThickness}"
                                        BackgroundColor="{Binding FontSizeNormalBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectFontSizeCommand}" CommandParameter="Normal" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding FontSizeNormal}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontFamily="InterMedium"
                                           FontSize="14"
                                           TextColor="{Binding FontSizeNormalTextColor}" />
                                </Border>

                                <!-- Nút: Lớn -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 10"
                                        HeightRequest="44"
                                        Stroke="{Binding FontSizeLargeBorder}"
                                        StrokeThickness="{Binding FontSizeLargeBorderThickness}"
                                        BackgroundColor="{Binding FontSizeLargeBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectFontSizeCommand}" CommandParameter="Large" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding FontSizeLarge}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           FontFamily="InterMedium"
                                           FontSize="14"
                                           TextColor="{Binding FontSizeLargeTextColor}" />
                                </Border>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- 3. SECTION: NGÔN NGỮ (LANGUAGE)                               -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <fluent:SymbolIcon Symbol="Globe"
                                           FontSize="18"
                                           ForegroundColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                        <Label Text="{Binding SectionLanguage}"
                               FontFamily="InterSemiBold"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Card tùy chỉnh Ngôn ngữ -->
                    <Border BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding AppLanguageText}"
                                       FontFamily="InterSemiBold"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding AppLanguageDesc}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Bộ chọn 2 ngôn ngữ có cờ (Touch Target >= 48dp) -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <!-- Tiếng Việt -->
                                <Border StrokeShape="RoundRectangle 12"
                                        HeightRequest="52"
                                        Padding="12,8"
                                        Stroke="{Binding LangVietnameseBorder}"
                                        StrokeThickness="{Binding LangVietnameseBorderThickness}"
                                        BackgroundColor="{Binding LangVietnameseBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectLanguageCommand}" CommandParameter="Vietnamese" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Text="🇻🇳" FontSize="20" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding LangVietnamese}"
                                               FontFamily="InterMedium"
                                               FontSize="14"
                                               TextColor="{Binding LangVietnameseTextColor}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="2"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Primary}"
                                                StrokeThickness="0"
                                                IsVisible="{Binding IsVietnamese}"
                                                VerticalOptions="Center">
                                            <fluent:SymbolIcon Symbol="Checkmark"
                                                               FontSize="12"
                                                               ForegroundColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- English -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        HeightRequest="52"
                                        Padding="12,8"
                                        Stroke="{Binding LangEnglishBorder}"
                                        StrokeThickness="{Binding LangEnglishBorderThickness}"
                                        BackgroundColor="{Binding LangEnglishBackground}"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCardTapped" Command="{Binding SelectLanguageCommand}" CommandParameter="English" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Text="🇬🇧" FontSize="20" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding LangEnglish}"
                                               FontFamily="InterMedium"
                                               FontSize="14"
                                               TextColor="{Binding LangEnglishTextColor}"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="2"
                                                WidthRequest="20"
                                                HeightRequest="20"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{DynamicResource Primary}"
                                                StrokeThickness="0"
                                                IsVisible="{Binding IsEnglish}"
                                                VerticalOptions="Center">
                                            <fluent:SymbolIcon Symbol="Checkmark"
                                                               FontSize="12"
                                                               ForegroundColor="White"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- 4. SECTION: XEM TRƯỚC (LIVE PREVIEW - DESIGN.MD 5.4)          -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <fluent:SymbolIcon Symbol="Eye"
                                           FontSize="18"
                                           ForegroundColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                        <Label Text="{Binding SectionPreview}"
                               FontFamily="InterSemiBold"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Thẻ xem trước kết quả đổi Theme và Cỡ chữ -->
                    <Border BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding PreviewTitle}"
                                       FontFamily="InterSemiBold"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding PreviewDesc}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>

                            <!-- Card công việc mẫu: Bố cục 2 tầng tuân thủ AGENTS.md Rule 6 -->
                            <Border BackgroundColor="{DynamicResource SurfaceVariant}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14,12">
                                <VerticalStackLayout Spacing="8">
                                    <!-- Tầng 1: Checkbox tròn + Tiêu đề công việc -->
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border WidthRequest="22"
                                                HeightRequest="22"
                                                StrokeShape="RoundRectangle 11"
                                                Stroke="{DynamicResource TextSecondary}"
                                                StrokeThickness="1.5"
                                                BackgroundColor="Transparent"
                                                VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding PreviewTaskTitle}"
                                               FontFamily="InterSemiBold"
                                               FontSize="{DynamicResource FontSizeBody}"
                                               TextColor="{DynamicResource TextPrimary}"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>

                                    <!-- Tầng 2: Tag dự án MyTasks App -->
                                    <HorizontalStackLayout Spacing="6" Margin="32,0,0,0" VerticalOptions="Center">
                                        <Border BackgroundColor="{DynamicResource PrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <fluent:SymbolIcon Symbol="Folder"
                                                                   FontSize="12"
                                                                   ForegroundColor="{DynamicResource Primary}"
                                                                   VerticalOptions="Center" />
                                                <Label Text="{Binding PreviewTaskProject}"
                                                       FontFamily="InterMedium"
                                                       FontSize="{DynamicResource FontSizeBadge}"
                                                       TextColor="{DynamicResource Primary}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- 5. SECTION: CÔNG CỤ KIỂM THỬ (REVIEWER TOOLS)                  -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <fluent:SymbolIcon Symbol="Wrench"
                                               FontSize="18"
                                               ForegroundColor="{DynamicResource TextSecondary}"
                                               VerticalOptions="Center" />
                            <Label Text="{Binding SectionReviewerTools}"
                                   FontFamily="InterSemiBold"
                                   FontSize="{DynamicResource FontSizeSubtitle}"
                                   TextColor="{DynamicResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding ReviewerToolsDesc}"
                               FontFamily="InterRegular"
                               FontSize="{DynamicResource FontSizeCaption}"
                               TextColor="{DynamicResource TextSecondary}"
                               Margin="26,0,0,0" />
                    </VerticalStackLayout>

                    <!-- Card công cụ kiểm thử -->
                    <Border BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,8">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="0">

                            <!-- Hàng 1: Trạng thái đang tải -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" HeightRequest="52" VerticalOptions="Center">
                                <Border WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{DynamicResource PrimaryLight}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <fluent:SymbolIcon Symbol="ArrowSync"
                                                       FontSize="16"
                                                       ForegroundColor="{DynamicResource Primary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding StateLoading}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="2"
                                        Text="{Binding ActionPreview}"
                                        Command="{Binding SimulateLoadingCommand}"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="18"
                                        BorderWidth="1"
                                        BorderColor="{DynamicResource Primary}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Primary}"
                                        FontFamily="InterMedium"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

                            <!-- Hàng 2: Danh sách trống -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" HeightRequest="52" VerticalOptions="Center">
                                <Border WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{DynamicResource PrimaryLight}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <fluent:SymbolIcon Symbol="CalendarEmpty"
                                                       FontSize="16"
                                                       ForegroundColor="{DynamicResource Primary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding StateEmpty}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="2"
                                        Text="{Binding ActionPreview}"
                                        Command="{Binding SimulateEmptyCommand}"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="18"
                                        BorderWidth="1"
                                        BorderColor="{DynamicResource Primary}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Primary}"
                                        FontFamily="InterMedium"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

                            <!-- Hàng 3: Không tìm thấy công việc -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" HeightRequest="52" VerticalOptions="Center">
                                <Border WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{DynamicResource DangerSurface}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <fluent:SymbolIcon Symbol="Dismiss"
                                                       FontSize="16"
                                                       ForegroundColor="{DynamicResource Danger}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding StateNotFound}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="2"
                                        Text="{Binding ActionPreview}"
                                        Command="{Binding SimulateNotFoundCommand}"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="18"
                                        BorderWidth="1"
                                        BorderColor="{DynamicResource Danger}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource Danger}"
                                        FontFamily="InterMedium"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />

                            <!-- Hàng 4: Đặt lại dữ liệu mẫu -->
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" HeightRequest="52" VerticalOptions="Center">
                                <Border WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{DynamicResource SurfaceVariant}"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <fluent:SymbolIcon Symbol="ArrowCounterclockwise"
                                                       FontSize="16"
                                                       ForegroundColor="{DynamicResource TextSecondary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding StateResetData}"
                                       FontFamily="InterMedium"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       TextColor="{DynamicResource TextPrimary}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="2"
                                        Text="{Binding ActionReset}"
                                        Command="{Binding ResetMockDataCommand}"
                                        HeightRequest="36"
                                        Padding="14,0"
                                        CornerRadius="18"
                                        BorderWidth="1"
                                        BorderColor="{DynamicResource BorderColor}"
                                        BackgroundColor="Transparent"
                                        TextColor="{DynamicResource TextSecondary}"
                                        FontFamily="InterMedium"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================================================= -->
                <!-- 6. SECTION: THÔNG TIN ỨNG DỤNG (APP INFO VỚI LOGO BO VIỀN)    -->
                <!-- ============================================================= -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <fluent:SymbolIcon Symbol="Info"
                                           FontSize="18"
                                           ForegroundColor="{DynamicResource TextSecondary}"
                                           VerticalOptions="Center" />
                        <Label Text="{Binding SectionAppInfo}"
                               FontFamily="InterSemiBold"
                               FontSize="{DynamicResource FontSizeSubtitle}"
                               TextColor="{DynamicResource TextPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Card thông tin ứng dụng -->
                    <Border BackgroundColor="{DynamicResource Surface}"
                            Stroke="{DynamicResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Logo bo góc vuông mềm (Squircle) chuẩn thương hiệu với clip hình học -->
                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    BackgroundColor="{DynamicResource Surface}"
                                    Padding="3"
                                    VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="Black"
                                            Offset="0,1"
                                            Radius="4"
                                            Opacity="0.08" />
                                </Border.Shadow>
                                <Image Source="logo.png"
                                       Aspect="AspectFill"
                                       WidthRequest="38"
                                       HeightRequest="38"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Image.Clip>
                                        <RoundRectangleGeometry Rect="0,0,38,38" CornerRadius="10" />
                                    </Image.Clip>
                                </Image>
                            </Border>

                            <!-- Thông tin ứng dụng và số phiên bản -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="MyTasks"
                                       FontFamily="InterBold"
                                       FontSize="16"
                                       TextColor="{DynamicResource Primary}" />
                                <Label Text="{Binding AppDescription}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding AppVersion}"
                                       FontFamily="InterRegular"
                                       FontSize="{DynamicResource FontSizeBadge}"
                                       TextColor="{DynamicResource TextMuted}"
                                       Margin="0,2,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============================================================= -->
        <!-- FLOATING SNACKBAR / TOAST PHẢN HỒI THAO TÁC CÀI ĐẶT           -->
        <!-- ============================================================= -->
        <Border BackgroundColor="{DynamicResource SnackbarBg}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                Padding="16,12"
                Margin="20,0,20,20"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                IsVisible="{Binding IsSnackbarVisible}"
                InputTransparent="False">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.18" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                <fluent:SymbolIcon Symbol="CheckmarkCircle"
                                   FontSize="20"
                                   ForegroundColor="{DynamicResource Success}"
                                   VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding SnackbarMessage}"
                       FontFamily="InterMedium"
                       FontSize="{DynamicResource FontSizeBody}"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>

</ContentPage>
