<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fluent="clr-namespace:FluentIcons.Maui;assembly=FluentIcons.Maui"
             x:Class="MyTasksApp.Controls.EmptyStateView"
             x:Name="this">

    <VerticalStackLayout Spacing="16"
                         Padding="20,32"
                         HorizontalOptions="Center"
                         VerticalOptions="Center">
        <!-- Vòng tròn nền chứa Icon đồng bộ (88x88dp, r44) -->
        <Border x:Name="IconContainer"
                WidthRequest="88"
                HeightRequest="88"
                StrokeShape="RoundRectangle 44"
                BackgroundColor="{DynamicResource PrimaryLight}"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <fluent:SymbolIcon x:Name="IconElement"
                               Symbol="{Binding Symbol, Source={x:Reference this}}"
                               FontSize="{Binding IconSize, Source={x:Reference this}}"
                               ForegroundColor="{DynamicResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Border>

        <!-- Tiêu đề (Dòng 1 - In đậm) -->
        <Label Text="{Binding Title, Source={x:Reference this}}"
               FontFamily="InterSemiBold"
               FontSize="{DynamicResource FontSizeTitle}"
               TextColor="{DynamicResource TextPrimary}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap"
               MaximumWidthRequest="340" />

        <!-- Phụ đề (Dòng 2 - Mềm mại, giải thích chi tiết) -->
        <Label Text="{Binding Subtitle, Source={x:Reference this}}"
               FontFamily="InterRegular"
               FontSize="{DynamicResource FontSizeBody}"
               TextColor="{DynamicResource TextSecondary}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               LineBreakMode="WordWrap"
               MaximumWidthRequest="340"
               IsVisible="{Binding HasSubtitle, Source={x:Reference this}}" />
    </VerticalStackLayout>
</ContentView>
